; Save Editor companion item: using it opens the companion menu over the game.
; Based on the vanilla booster (class S_FOOD) so the game fires use_object;
; the mod gives a fresh one back right after use. Icon and model are the
; vanilla PDA's (misc\items.ltx [device_pda]). Included from the end of
; misc\quest_items.ltx by the installer.

[se_companion_pda]:booster
$spawn				= "devices\se_companion_pda"
visual				= dynamics\devices\dev_pda\dev_pda.ogf
description			= Открывает меню компаньона Save Editor поверх игры. Нельзя продать или выбросить.
inv_name			= КПК компаньона
inv_name_short		= КПК компаньона
inv_weight			= 0.0
inv_grid_width		= 1
inv_grid_height		= 1
inv_grid_x			= 6
inv_grid_y			= 13
cost				= 0
can_trade			= false
quest_item			= true
eat_portions_num	= 1
