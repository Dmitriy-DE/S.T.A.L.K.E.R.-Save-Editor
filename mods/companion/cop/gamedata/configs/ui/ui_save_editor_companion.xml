<?xml version="1.0" encoding="windows-1251"?>
<!-- Save Editor companion menu for Call of Pripyat. Textures and control
     markup follow the vanilla load dialog (configs/ui/ui_mm_load_dlg.xml) and
     the «Повелитель Зоны 5.0» menu (configs/ui/ui_mm_god_dlg.xml). Source is
     UTF-8; the installer writes it as windows-1251 for the game. -->
<w>
	<background width="1024" height="768">
		<auto_static width="1024" height="768">
			<texture>ui_inGame2_background</texture>
		</auto_static>
	</background>
	<list_item height="18"/>
	<form x="182" y="70" width="660" height="640" stretch="1">
		<texture>ui_inGame2_main_window_small</texture>
		<caption x="0" y="18" width="660" height="30">
			<text font="graffiti32" align="c">Save Editor</text>
		</caption>

		<cap_money x="35" y="62" width="120" height="22">
			<text font="letterica16" r="115" g="114" b="112" vert_align="c">Деньги:</text>
		</cap_money>
		<money x="130" y="62" width="200" height="22">
			<text font="graffiti22" color="ui_7" vert_align="c"/>
		</money>
		<btn_money_minus x="330" y="62" width="60" height="22">
			<texture>ui_inGame2_Mp_bigbuttone</texture>
			<text align="c" font="letterica16" r="227" g="199" b="178">-10к</text>
		</btn_money_minus>
		<btn_money_plus x="395" y="62" width="60" height="22">
			<texture>ui_inGame2_Mp_bigbuttone</texture>
			<text align="c" font="letterica16" r="227" g="199" b="178">+10к</text>
		</btn_money_plus>

		<cap_time x="35" y="92" width="160" height="22">
			<text font="letterica16" r="115" g="114" b="112" vert_align="c">Скорость времени:</text>
		</cap_time>
		<time x="200" y="92" width="120" height="22">
			<text font="graffiti22" color="ui_6" vert_align="c"/>
		</time>
		<btn_time_minus x="330" y="92" width="60" height="22">
			<texture>ui_inGame2_Mp_bigbuttone</texture>
			<text align="c" font="letterica16" r="227" g="199" b="178">-</text>
		</btn_time_minus>
		<btn_time_plus x="395" y="92" width="60" height="22">
			<texture>ui_inGame2_Mp_bigbuttone</texture>
			<text align="c" font="letterica16" r="227" g="199" b="178">+</text>
		</btn_time_plus>

		<btn_surge x="480" y="62" width="145" height="26">
			<texture>ui_inGame2_Mp_bigbuttone</texture>
			<text font="letterica18">Выброс</text>
		</btn_surge>

		<check_god x="35" y="125" width="260" height="29">
			<texture>ui_inGame2_checkbox</texture>
			<text font="letterica16" vert_align="c">Бессмертие</text>
		</check_god>
		<check_stamina x="35" y="155" width="260" height="29">
			<texture>ui_inGame2_checkbox</texture>
			<text font="letterica16" vert_align="c">Бесконечная выносливость</text>
		</check_stamina>
		<check_bleeding x="35" y="185" width="260" height="29">
			<texture>ui_inGame2_checkbox</texture>
			<text font="letterica16" vert_align="c">Без кровотечения</text>
		</check_bleeding>
		<check_repair x="330" y="125" width="260" height="29">
			<texture>ui_inGame2_checkbox</texture>
			<text font="letterica16" vert_align="c">Авторемонт надетого</text>
		</check_repair>
		<check_ammo x="330" y="155" width="260" height="29">
			<texture>ui_inGame2_checkbox</texture>
			<text font="letterica16" vert_align="c">Бесконечные патроны</text>
		</check_ammo>

		<status x="35" y="218" width="590" height="22">
			<text font="letterica16" r="216" g="186" b="140" vert_align="c"/>
		</status>

		<category x="35" y="248" width="300" height="21" list_length="10">
			<text_color>
				<e r="216" g="186" b="140"/>
				<d color="ui_gray"/>
			</text_color>
			<list_font_s r="240" g="217" b="182"/>
			<list_font r="216" g="186" b="140" font="letterica16"/>
		</category>
		<cap_count x="360" y="248" width="80" height="22">
			<text font="letterica16" r="115" g="114" b="112" vert_align="c">Кол-во:</text>
		</cap_count>
		<count x="430" y="248" width="50" height="22">
			<text font="graffiti22" color="ui_6" align="c" vert_align="c"/>
		</count>
		<btn_count_minus x="485" y="248" width="60" height="22">
			<texture>ui_inGame2_Mp_bigbuttone</texture>
			<text align="c" font="letterica16" r="227" g="199" b="178">-</text>
		</btn_count_minus>
		<btn_count_plus x="550" y="248" width="60" height="22">
			<texture>ui_inGame2_Mp_bigbuttone</texture>
			<text align="c" font="letterica16" r="227" g="199" b="178">+</text>
		</btn_count_plus>

		<list_frame x="35" y="280" width="590" height="290">
			<texture>ui_inGame2_servers_list_frame</texture>
		</list_frame>
		<list x="38" y="282" width="585" height="286" item_height="18" can_select="1">
			<font font="letterica16"/>
		</list>

		<btn_do x="45" y="590" width="175" height="26">
			<texture>ui_inGame2_Mp_bigbuttone</texture>
			<text font="letterica18">Сделать!</text>
		</btn_do>
		<btn_mark x="243" y="590" width="175" height="26">
			<texture>ui_inGame2_Mp_bigbuttone</texture>
			<text font="letterica18">Запомнить / удалить</text>
		</btn_mark>
		<btn_back x="441" y="590" width="175" height="26">
			<texture>ui_inGame2_Mp_bigbuttone</texture>
			<text font="letterica18">Назад</text>
		</btn_back>
	</form>
</w>
