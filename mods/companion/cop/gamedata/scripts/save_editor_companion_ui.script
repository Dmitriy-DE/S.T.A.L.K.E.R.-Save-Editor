--[[
  Save Editor companion — in-game menu for Call of Pripyat (Esc, then F1).
  Money, time speed, surge, toggles (immortality, stamina, bleeding,
  auto-repair, ammo), teleport to named places and saved points, item spawn
  by category. Window code follows the vanilla load dialog
  (ui_load_dialog.script) and the «Повелитель Зоны 5.0» menu:
  https://github.com/xray-storage/so-xray/blob/master/gamedata/scripts/ui_god_dialog.script
  Actions live in save_editor_companion.script; item lists in
  save_editor_catalog.script (generated from the editor's catalog).
  Source is UTF-8; the installer writes it as windows-1251 for the game.
--]]

local MONEY_STEP = 10000
local MAX_COUNT = 100
local TIME_FACTORS = { 1, 2, 5, 10, 20, 50, 100 }
local POINTS_FILE = "save_editor_points.txt"

local CATEGORIES = {
	{ id = "places", title = "Места" },
	{ id = "points", title = "Мои точки" },
	{ id = "weapon", title = "Оружие" },
	{ id = "ammo", title = "Патроны" },
	{ id = "outfit", title = "Броня" },
	{ id = "artifact", title = "Артефакты" },
	{ id = "grenade", title = "Гранаты" },
	{ id = "consumable", title = "Медицина и еда" },
	{ id = "item", title = "Прочее" },
}

local CHECKS = {
	{ id = "god", control = "form:check_god" },
	{ id = "stamina", control = "form:check_stamina" },
	{ id = "bleeding", control = "form:check_bleeding" },
	{ id = "repair", control = "form:check_repair" },
	{ id = "ammo", control = "form:check_ammo" },
}

-- Saved points: one line "level|x|y|z|game_vertex|name" in $app_data_root$.
local function points_path()
	return getFS():update_path("$app_data_root$", POINTS_FILE)
end

local function load_points()
	local points = {}
	local f = io.open(points_path(), "r")
	if f == nil then
		return points
	end
	for line in f:lines() do
		local lvl, x, y, z, gv, name = string.match(line, "^([^|]+)|([^|]+)|([^|]+)|([^|]+)|([^|]+)|(.*)$")
		if lvl ~= nil then
			table.insert(points, {
				level = lvl, pos = vector():set(tonumber(x), tonumber(y), tonumber(z)),
				gv = tonumber(gv), name = name,
			})
		end
	end
	f:close()
	return points
end

local function save_points(points)
	local f = io.open(points_path(), "w")
	if f == nil then
		return
	end
	for _, p in ipairs(points) do
		f:write(string.format("%s|%.3f|%.3f|%.3f|%d|%s\n", p.level, p.pos.x, p.pos.y, p.pos.z, p.gv, p.name))
	end
	f:close()
end

local function item_title(section)
	local ini = system_ini()
	if not ini:section_exist(section) or not ini:line_exist(section, "inv_name") then
		return nil
	end
	return game.translate_string(ini:r_string(section, "inv_name"))
end

class "companion_item" (CUIListBoxItem)

function companion_item:__init(height) super(height)
	self:SetTextColor(GetARGB(255, 216, 186, 140))
	self.fn = self:GetTextItem()
	self.fn:SetFont(GetFontLetterica16Russian())
	self.fn:SetEllipsis(true)
end

class "companion_dialog" (CUIScriptWnd)

function companion_dialog:__init(owner) super()
	self.owner = owner
	self.entries = {}
	self.count = 1
	self.category = 1
	self:InitControls()
	self:InitCallBacks()
	self:Refresh()
	self:Fill()
end

function companion_dialog:InitControls()
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	local xml = CScriptXmlInit()
	xml:ParseFile("ui_save_editor_companion.xml")
	xml:InitStatic("background", self)

	local probe = CUIWindow()
	xml:InitWindow("list_item", 0, probe)
	self.item_height = probe:GetHeight()

	self.form = xml:InitStatic("form", self)
	xml:InitStatic("form:caption", self.form)
	xml:InitStatic("form:cap_money", self.form)
	xml:InitStatic("form:cap_time", self.form)
	xml:InitStatic("form:cap_count", self.form)
	self.money = xml:InitTextWnd("form:money", self.form)
	self.time = xml:InitTextWnd("form:time", self.form)
	self.count_text = xml:InitTextWnd("form:count", self.form)
	self.status = xml:InitTextWnd("form:status", self.form)

	local buttons = {
		"btn_money_minus", "btn_money_plus", "btn_time_minus", "btn_time_plus", "btn_surge",
		"btn_count_minus", "btn_count_plus", "btn_do", "btn_mark", "btn_back",
	}
	for _, name in ipairs(buttons) do
		self:Register(xml:Init3tButton("form:" .. name, self.form), name)
	end

	self.checks = {}
	local toggles = save_editor_companion.get_toggles()
	for _, check in ipairs(CHECKS) do
		local ctrl = xml:InitCheck(check.control, self.form)
		ctrl:SetCheck(toggles[check.id] == true)
		self:Register(ctrl, "check_" .. check.id)
		self.checks[check.id] = ctrl
	end

	self.category_box = xml:InitComboBox("form:category", self.form)
	for index, category in ipairs(CATEGORIES) do
		self.category_box:AddItem(category.title, index - 1)
	end
	self.category_box:SetText(CATEGORIES[1].title) -- CoP combo has no SetCurrentID; CurrentID() starts at the first item
	self:Register(self.category_box, "category")

	xml:InitFrame("form:list_frame", self.form)
	self.list_box = xml:InitListBox("form:list", self.form)
	self.list_box:ShowSelectedItem(true)
	self:Register(self.list_box, "list_window")
end

function companion_dialog:InitCallBacks()
	local clicked = ui_events.BUTTON_CLICKED
	self:AddCallback("btn_money_minus", clicked, function() self:Money(-MONEY_STEP) end, self)
	self:AddCallback("btn_money_plus", clicked, function() self:Money(MONEY_STEP) end, self)
	self:AddCallback("btn_time_minus", clicked, function() self:Time(-1) end, self)
	self:AddCallback("btn_time_plus", clicked, function() self:Time(1) end, self)
	self:AddCallback("btn_surge", clicked, self.Surge, self)
	self:AddCallback("btn_count_minus", clicked, function() self:Count(-1) end, self)
	self:AddCallback("btn_count_plus", clicked, function() self:Count(1) end, self)
	self:AddCallback("btn_do", clicked, self.OnDo, self)
	self:AddCallback("btn_mark", clicked, self.OnMark, self)
	self:AddCallback("btn_back", clicked, self.OnBack, self)
	for _, check in ipairs(CHECKS) do
		local id = check.id
		self:AddCallback("check_" .. id, ui_events.CHECK_BUTTON_SET, function()
			save_editor_companion.set_toggle(id, true)
		end, self)
		self:AddCallback("check_" .. id, ui_events.CHECK_BUTTON_RESET, function()
			save_editor_companion.set_toggle(id, false)
		end, self)
	end
	self:AddCallback("category", ui_events.LIST_ITEM_SELECT, self.OnCategory, self)
	self:AddCallback("list_window", ui_events.WINDOW_LBUTTON_DB_CLICK, self.OnDo, self)
end

function companion_dialog:Say(text)
	self.status:SetText(text)
end

function companion_dialog:Refresh()
	self.money:SetText(tostring(db.actor:money()) .. " RU")
	self.time:SetText("x" .. tostring(level.get_time_factor()))
	self.count_text:SetText(tostring(self.count))
end

function companion_dialog:Money(delta)
	local status, text = save_editor_companion.run("money", { tostring(delta) })
	if status ~= "ok" then
		self:Say(text)
	end
	self:Refresh()
end

function companion_dialog:Time(step)
	local current = level.get_time_factor()
	local index = 1
	for i, factor in ipairs(TIME_FACTORS) do
		if factor <= current then
			index = i
		end
	end
	index = math.max(1, math.min(#TIME_FACTORS, index + step))
	level.set_time_factor(TIME_FACTORS[index])
	self:Refresh()
end

function companion_dialog:Surge()
	if surge_manager == nil or surge_manager.start_surge == nil then
		self:Say("Выброс в этой игре не поддерживается")
		return
	end
	surge_manager.start_surge()
	self:Close(true)
end

function companion_dialog:Count(step)
	self.count = math.max(1, math.min(MAX_COUNT, self.count + step))
	self:Refresh()
end

function companion_dialog:Add(text, entry)
	local item = companion_item(self.item_height)
	item.fn:SetText(text)
	self.list_box:AddExistingItem(item)
	table.insert(self.entries, entry)
end

function companion_dialog:Fill()
	self.list_box:RemoveAll()
	self.entries = {}
	local category = CATEGORIES[self.category].id
	if category == "places" then
		local places = save_editor_companion.all_smarts()
		table.sort(places, function(a, b)
			if a.level ~= b.level then
				return a.level < b.level
			end
			return a.title < b.title
		end)
		for _, smart in ipairs(places) do
			if smart.title ~= "" then
				self:Add(game.translate_string(smart.level) .. ": " .. smart.title, { kind = "smart", smart = smart })
			end
		end
	elseif category == "points" then
		self.points = load_points()
		for index, p in ipairs(self.points) do
			self:Add(p.name, { kind = "point", index = index })
		end
	else
		local rows = {}
		for _, section in ipairs(save_editor_catalog.items[category] or {}) do
			local title = item_title(section)
			if title ~= nil then
				table.insert(rows, { title = title, section = section })
			end
		end
		table.sort(rows, function(a, b) return a.title < b.title end)
		for _, row in ipairs(rows) do
			self:Add(row.title, { kind = "item", section = row.section })
		end
	end
	self:Say(game.translate_string(level.name()))
end

function companion_dialog:OnCategory()
	self.category = self.category_box:CurrentID() + 1
	self:Fill()
end

function companion_dialog:Selected()
	local index = self.list_box:GetSelectedIndex()
	if index == nil or index < 0 then
		return nil
	end
	return self.entries[index + 1]
end

function companion_dialog:Close(to_game)
	self.owner:ShowDialog(true)
	self:HideDialog()
	self.owner:Show(true)
	if to_game then
		self.owner:OnButton_return_game()
	end
end

function companion_dialog:OnDo()
	local entry = self:Selected()
	if entry == nil then
		self:Say("Выбери строку в списке")
		return
	end
	local status, text
	if entry.kind == "item" then
		status, text = save_editor_companion.run("give", { entry.section, tostring(self.count) })
		self:Say(status == "ok" and ("Выдано: " .. item_title(entry.section) .. " x" .. self.count) or text)
		return
	elseif entry.kind == "point" then
		local p = self.points[entry.index]
		status, text = save_editor_companion.jump_to(p.level, p.pos, p.gv, p.name)
	else
		local s = entry.smart
		status, text = save_editor_companion.jump_to(s.level, s.obj.position, s.obj.m_game_vertex_id, s.name)
	end
	if status ~= "ok" then
		self:Say(tostring(text))
		return
	end
	self:Close(true)
end

-- Save the current spot, or delete the selected saved point.
function companion_dialog:OnMark()
	local points = load_points()
	local entry = self:Selected()
	if CATEGORIES[self.category].id == "points" and entry ~= nil then
		table.remove(points, entry.index)
		save_points(points)
		self:Fill()
		self:Say("Точка удалена")
		return
	end
	local actor = db.actor
	local name = game.translate_string(level.name()) .. " #" .. (#points + 1)
	table.insert(points, { level = level.name(), pos = actor:position(), gv = actor:game_vertex_id(), name = name })
	save_points(points)
	self:Fill()
	self:Say("Запомнено: " .. name)
end

function companion_dialog:OnBack()
	self:Close(false)
end

function companion_dialog:OnKeyboard(dik, keyboard_action)
	CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
	if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
		if dik == DIK_keys.DIK_ESCAPE then
			self:OnBack()
		elseif dik == DIK_keys.DIK_RETURN then
			self:OnDo()
		end
	end
	return true
end

-- Called from main_menu:OnKeyboard while the pause menu is open.
function on_menu_key(dik, menu)
	if dik == DIK_keys.DIK_F1 and level.present() and db.actor ~= nil and db.actor:alive() then
		local dlg = companion_dialog(menu)
		dlg:ShowDialog(true)
		menu:HideDialog()
		menu:Show(false)
	end
end
