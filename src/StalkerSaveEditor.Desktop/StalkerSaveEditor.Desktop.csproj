<Project Sdk="Microsoft.NET.Sdk">
  <!-- The interface shared by the desktop host (StalkerSaveEditor.App) and the web host (StalkerSaveEditor.Browser). -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="i18n/*.json" />
    <None Include="Assets/Sounds/**/*" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
    <None Include="Assets/Fonts/*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets/Icons/**/*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets/PROVENANCE.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <ProjectReference Include="../StalkerSaveEditor.Core/StalkerSaveEditor.Core.csproj" />
    <ProjectReference Include="../StalkerSaveEditor.Steam/StalkerSaveEditor.Steam.csproj" />
    <ProjectReference Include="../StalkerSaveEditor.Updater/StalkerSaveEditor.Updater.csproj" />
  </ItemGroup>
</Project>
