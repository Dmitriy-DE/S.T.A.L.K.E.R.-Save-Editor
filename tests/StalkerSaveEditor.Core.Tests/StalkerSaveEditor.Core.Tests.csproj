<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- xUnit method names use underscores to separate readable test clauses. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <ProjectReference Include="../../src/StalkerSaveEditor.Core/StalkerSaveEditor.Core.csproj" />
    <ProjectReference Include="../../src/StalkerSaveEditor.Desktop/StalkerSaveEditor.Desktop.csproj" />
    <ProjectReference Include="../../src/StalkerSaveEditor.Updater/StalkerSaveEditor.Updater.csproj" />
    <None Include="../Fixtures/**/*" Link="Fixtures/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../golden/**/*" Link="golden/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/PARITY.csv" Link="golden/PARITY.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
